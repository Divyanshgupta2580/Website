# ============================================================
# GG Construction Co. — Environment Configuration
# ============================================================

# Public application URL
# Used for canonical URLs, metadata, sitemap and robots.txt.
# Example:
# https://www.example.com
NEXT_PUBLIC_APP_URL=

# ============================================================
# Optional CRM Integration
# Keep these server-side secrets.
# Do NOT prefix them with NEXT_PUBLIC_.
# ============================================================

# CRM webhook endpoint for lead forwarding
CRM_WEBHOOK_URL=

# Bearer token used to authenticate with the CRM webhook
CRM_API_BEARER_TOKEN=

# ============================================================
# Optional Email Notification Integration
# Keep these server-side secrets.
# Do NOT expose them to browser code.
# ============================================================

# Email notification relay endpoint
EMAIL_NOTIFICATION_ENDPOINT=

# Secret/API key used by the email notification relay
EMAIL_SERVICE_KEY=

# ============================================================
# Deployment Notes
# ============================================================

# Do NOT define PORT for standard Vercel deployment.
# Do NOT commit .env, .env.local or production secret files.
# Configure production secrets in the deployment platform.
