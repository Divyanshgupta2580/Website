# GG Construction Co. - Environment Configuration Template
# DO NOT COMMIT PRODUCTION SECRETS OR SENSITIVE API KEYS TO SOURCE CONTROL
# Copy this file to .env.local for local development

# Application Canonical Base URL (Used for Sitemap, Robots, and OpenGraph metadata)
NEXT_PUBLIC_APP_URL=https://ggconstruction.com

# Node Environment
NODE_ENV=production

# -----------------------------------------------------------------------------
# Optional Downstream Integrations (API Form Dispatchers)
# When omitted, forms safely log anonymized submissions server-side with zero failures.
# -----------------------------------------------------------------------------

# CRM Webhook Endpoint (Receives JSON POST of validated contact & quote submissions)
# CRM_WEBHOOK_URL=https://crm.example.com/api/v1/leads

# Bearer token for authenticating against CRM webhook (sent in Authorization header)
# CRM_API_BEARER_TOKEN=

# Corporate Email Notification Relay (Receives JSON POST of incoming customer leads)
# EMAIL_NOTIFICATION_ENDPOINT=https://email-relay.example.com/api/send

# Optional service key for internal email dispatch relay (sent in X-Service-Key header)
# EMAIL_SERVICE_KEY=
